---
import camperRaw from '../assets/brand/camper.svg?raw';
import textoRaw from '../assets/brand/texto.svg?raw';
import { url } from '../config';
const links = [
  { href: 'blog', label: 'Blog' },
  { href: 'destinos', label: 'Destinos' },
  { href: 'rancherita', label: 'Rancherita' },
  { href: 'nosotros', label: 'Nosotros' },
];
const path = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '').replace(/^\/|\/$/g, '');
const icon = camperRaw.replaceAll('id="g"', 'id="hdr-g"').replaceAll('url(#g)', 'url(#hdr-g)');
const name = textoRaw.replaceAll('id="g"', 'id="hdr-t"').replaceAll('url(#g)', 'url(#hdr-t)');
---
<header class="site-header">
  <div class="wrap bar">
    <a href={url('')} class="home" aria-label="Rancherita, inicio">
      <span class="icon" set:html={icon} />
      <span class="name" set:html={name} />
    </a>
    <button class="toggle" aria-expanded="false" aria-controls="menu"><span class="sr-only">Menú</span><span></span><span></span></button>
    <nav id="menu" aria-label="Principal">
      {links.map((l) => (
        <a href={url(l.href)} aria-current={path.split('/')[0] === l.href ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>
  </div>
</header>

<style>
  .site-header { position: sticky; top: 0; z-index: 50; background: rgba(11, 18, 12, .82); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border-bottom: 1px solid rgba(38, 51, 42, .6); }
  .bar { display: flex; align-items: center; justify-content: space-between; height: 68px; }
  .home { display: flex; align-items: center; gap: 12px; text-decoration: none; }
  .icon { width: 52px; display: block; }
  .icon :global(svg) { display: block; }
  .name { width: 132px; display: block; }
  .name :global(svg) { display: block; width: 100%; height: auto; }
  nav { display: flex; gap: 6px; }
  nav a { font-family: var(--font-display); font-size: .68rem; letter-spacing: .18em; text-transform: uppercase; color: var(--texto-suave); text-decoration: none; padding: .7em 1em; border-radius: 999px; transition: color .2s, background .2s; }
  nav a:hover { color: var(--texto); background: var(--noche-3); }
  nav a[aria-current='page'] { color: var(--arena); }
  .toggle { display: none; }
  @media (max-width: 760px) {
    .toggle { display: grid; gap: 6px; background: none; border: 0; padding: 12px; cursor: pointer; }
    .toggle span:not(.sr-only) { width: 24px; height: 1.5px; background: var(--arena); transition: transform .25s; }
    .toggle[aria-expanded='true'] span:nth-of-type(2) { transform: translateY(3.75px) rotate(45deg); }
    .toggle[aria-expanded='true'] span:nth-of-type(3) { transform: translateY(-3.75px) rotate(-45deg); }
    nav { position: absolute; top: 68px; left: 0; right: 0; flex-direction: column; background: var(--noche); border-bottom: 1px solid var(--linea); padding: 12px var(--gutter) 24px; display: none; }
    nav.open { display: flex; }
    nav a { font-size: .8rem; padding: 1em 0; border-radius: 0; border-bottom: 1px solid var(--linea); }
    nav a:hover { background: none; }
  }
</style>

<script>
  const btn = document.querySelector('.toggle');
  const nav = document.getElementById('menu');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') !== 'true';
    btn.setAttribute('aria-expanded', String(open));
    nav?.classList.toggle('open', open);
  });
</script>
