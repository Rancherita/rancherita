---
// Logotipo original completo (aro + autocaravana + RANCHERITA).
import logoRaw from '../assets/brand/logo.svg?raw';
interface Props { size?: string; animate?: boolean; class?: string }
const { size = '320px', animate = false, class: cls = '' } = Astro.props;
const uid = Math.random().toString(36).slice(2, 8);
const logo = logoRaw
  .replace(/<!--[\s\S]*?-->\s*/, '')
  .replaceAll('id="g"', `id="l${uid}"`)
  .replaceAll('url(#g)', `url(#l${uid})`)
  .replace('<svg ', '<svg aria-hidden="true" ');
---
<div class:list={['logo', cls, { animate }]} style={`--size:${size}`} role="img" aria-label="Rancherita" set:html={logo} />

<style>
  .logo { width: var(--size); }
  .logo :global(svg) { display: block; width: 100%; height: auto; }
  .animate { opacity: 0; transform: scale(.96); filter: blur(4px); animation: in 1.4s .2s cubic-bezier(.2,.7,.2,1) forwards; }
  @keyframes in { to { opacity: 1; transform: none; filter: none; } }
  @media (prefers-reduced-motion: reduce) { .animate { animation: none; opacity: 1; transform: none; filter: none; } }
</style>
