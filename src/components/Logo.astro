---
// Logotipo completo (aro + autocaravana + RANCHERITA), fiel al original.
import camperRaw from '../assets/brand/camper.svg?raw';
interface Props { size?: string; animate?: boolean; class?: string }
const { size = '320px', animate = false, class: cls = '' } = Astro.props;
const uid = Math.random().toString(36).slice(2, 8);
const camper = camperRaw.replaceAll('id="g"', `id="c${uid}"`).replaceAll('url(#g)', `url(#c${uid})`);
---
<div class:list={['logo', cls, { animate }]} style={`--size:${size}`} role="img" aria-label="Rancherita">
  <svg class="ring" viewBox="0 0 100 100" aria-hidden="true">
    <defs>
      <linearGradient id={`r${uid}`} gradientUnits="userSpaceOnUse" x1="10" y1="0" x2="90" y2="0">
        <stop offset="0" stop-color="#CFE3AE" /><stop offset="1" stop-color="#F4D59A" />
      </linearGradient>
      <mask id={`m${uid}`}><rect width="100" height="100" fill="#fff" /><rect x="0" y="56" width="100" height="14" fill="#000" /></mask>
    </defs>
    <circle cx="50" cy="50" r="41" fill="none" stroke={`url(#r${uid})`} stroke-width=".7" mask={`url(#m${uid})`} pathLength="100" />
  </svg>
  <div class="camper" set:html={camper} />
  <div class="word"><span class="brand-gradient">RANCHERITA</span></div>
</div>

<style>
  .logo { position: relative; width: var(--size); aspect-ratio: 1; container-type: inline-size; }
  .ring { position: absolute; inset: 0; width: 100%; height: 100%; }
  .camper { position: absolute; left: 28%; width: 44%; top: 27%; }
  .camper :global(svg) { display: block; width: 100%; height: auto; }
  .word { position: absolute; inset: 57.2% 0 auto; text-align: center; font-family: var(--font-display); font-size: 8.3cqi; letter-spacing: 0.14em; padding-left: 0.14em; line-height: 1.2; }
  .animate .ring circle { stroke-dasharray: 100; stroke-dashoffset: 100; animation: draw 2.2s 0.2s cubic-bezier(.6,.1,.2,1) forwards; }
  .animate .camper :global(path), .animate .camper :global(rect), .animate .camper :global(circle) { stroke-dasharray: 200; stroke-dashoffset: 200; animation: draw 2.4s .5s ease-out forwards; }
  .animate .word { opacity: 0; transform: translateY(6px); animation: rise 1s 1.6s ease-out forwards; }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  @keyframes rise { to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) {
    .animate .ring circle, .animate .camper :global(*), .animate .word { animation: none; stroke-dashoffset: 0; opacity: 1; transform: none; }
  }
</style>
