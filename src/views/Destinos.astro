---
import Base from '../layouts/Base.astro';
import Illustration from '../components/Illustration.astro';
import { DESTINOS, url } from '../config';
import { UI, href, type Lang } from '../i18n';
import { getPosts } from '../lib/posts';

interface Props { lang: Lang }
const { lang } = Astro.props;
const ui = UI[lang];
const T = {
  es: {
    title: 'Destinos',
    desc: 'Los sitios que hemos recorrido con Rancherita: Marruecos, los Balcanes hasta Albania, Normandía, Bretaña, Suiza y Corsica.',
    h1: 'Dónde hemos estado',
    lead: 'Marruecos, los Balcanes, Normandía, Bretaña, Suiza y Corsica. Y una lista muy larga de sitios a los que queremos llegar por pista.',
  },
  de: {
    title: 'Reiseziele',
    desc: 'Wo wir mit Rancherita unterwegs waren: Marokko, der Balkan bis Albanien, die Normandie, die Bretagne, die Schweiz und Corsica.',
    h1: 'Wo wir schon waren',
    lead: 'Marokko, der Balkan, die Normandie, die Bretagne, die Schweiz und Corsica. Und eine sehr lange Liste von Orten, die wir noch über Pisten erreichen wollen.',
  },
}[lang];
const posts = await getPosts(lang);
---
<Base title={T.title} description={T.desc}>
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">{T.title}</p>
      <h1>{T.h1}</h1>
      <p class="lead">{T.lead}</p>
      <div class="list">
        {Object.entries(DESTINOS).map(([id, d], i) => {
          const n = posts.filter((p) => p.data.destino === id).length;
          return (
            <a class:list={['row', 'reveal', { flip: i % 2 }]} href={href(`destinos/${id}`, lang)}>
              <div class="art">{d.foto ? <img src={url(d.foto)} alt={d[lang].fotoAlt ?? ''} loading="lazy" /> : <Illustration scene={d.cover} />}</div>
              <div class="copy">
                <span class="idx">0{i + 1}</span>
                <h2>{d[lang].nombre}</h2>
                <p>{d[lang].resumen}</p>
                <span class="link-arrow">{ui.entries(n)}</span>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>
</Base>
<style>
  .list { display: flex; flex-direction: column; gap: 56px; margin-top: 64px; }
  .row { display: grid; grid-template-columns: 1.2fr 1fr; gap: clamp(28px, 5vw, 64px); align-items: center; color: var(--texto); text-decoration: none; }
  .row.flip .art { order: 2; }
  .art { border-radius: var(--radio); overflow: hidden; border: 1px solid var(--linea); aspect-ratio: 16 / 10; }
  .art img, .art :global(svg) { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .7s; }
  .row:hover .art img, .row:hover .art :global(svg) { transform: scale(1.04); }
  .idx { font-family: var(--font-display); color: var(--arena); letter-spacing: .2em; font-size: .8rem; }
  .copy h2 { font-size: clamp(2rem, 4vw, 3rem); margin: .3em 0; }
  .copy p { color: var(--texto-suave); font-family: var(--font-body); font-size: 1.1rem; }
  .row:hover h2 { color: var(--arena); }
  @media (max-width: 800px) { .row { grid-template-columns: 1fr; } .row.flip .art { order: 0; } }
</style>
