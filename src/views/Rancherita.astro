---
import Base from '../layouts/Base.astro';
import { url } from '../config';
import { href, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const T = {
  es: {
    title: 'La autocaravana',
    desc: 'Rancherita: una Toyota Hilux 4×4 con una cabina de más de 20 años preparada para vivir con autonomía. Nuestra casa sobre ruedas para viajar por pistas.',
    eyebrow: 'La autocaravana',
    h1: 'Esta es',
    lead: 'Una Toyota Hilux 4×4 con una cabina de más de 20 años encima, preparada para vivir de forma autosuficiente. Compacta, robusta y capaz de seguir cuando la carretera se convierte en pista. Es nuestro medio de transporte, nuestra casa y, a estas alturas, un miembro más del equipo.',
    alt: 'Rancherita, la Toyota Hilux con su cabina, en una carretera entre montañas áridas de Marruecos bajo un cielo azul',
    fichaTitle: 'Ficha técnica',
    ficha: [
      ['Vehículo base', 'Toyota Hilux, pick-up 4×4'],
      ['Tracción', 'Doble tracción con reductora'],
      ['Vivienda', 'Cabina de más de 20 años sobre la caja'],
      ['Energía', 'Placas solares y batería'],
      ['Baño', 'Seco y ecológico'],
      ['Cama', 'Sobre la cabina del conductor'],
      ['Cocina', 'A bordo, para cocinar donde paremos'],
      ['Agua', 'Depósito propio'],
      ['Nombre', 'Rancherita, por supuesto'],
      ['Pensada para', 'Pistas, arena, montaña y largas temporadas'],
    ],
    whyPickup: '¿Por qué una pick-up?',
    whyPickupP: 'Porque queríamos llegar donde no llega una furgoneta. Tracción total, altura libre, una mecánica que se conoce en todo el mundo y un tamaño que cabe por calles de aldea y pistas entre muros de piedra.',
    whyCabin: '¿Por qué esta cabina?',
    whyCabinP: 'Tiene más de 20 años y hoy está preparada para vivir de forma autosuficiente: placas solares, batería, baño seco ecológico, agua y cocina a bordo. Es ligera, está hecha para vivir dentro y se puede desmontar. Nos da la autonomía para dormir donde nos guste —no donde nos dejen— sin renunciar a la capacidad de la 4×4.',
    gear: 'Lo que llevamos',
    gearP: 'Compresor, planchas, pala, eslinga, herramientas y repuestos básicos. Lo contamos con detalle en',
    gearLink: 'esta entrada',
    story: 'Su historia',
    storyP: 'Con ella hemos pasado cuatro meses y medio en Marruecos y hemos recorrido los Balcanes hasta Albania, Normandía, Bretaña, Suiza y Corsica. La historia completa, en',
    storyLink: 'Presentamos a Rancherita',
  },
  de: {
    title: 'Das Wohnmobil',
    desc: 'Rancherita: ein Toyota Hilux 4×4 mit einer über 20 Jahre alten Wohnkabine, eingerichtet für ein autarkes Leben. Unser Zuhause auf Rädern für Reisen auf Pisten.',
    eyebrow: 'Das Wohnmobil',
    h1: 'Das ist',
    lead: 'Ein Toyota Hilux 4×4 mit einer über 20 Jahre alten Wohnkabine obendrauf, eingerichtet für ein autarkes Leben. Kompakt, robust und fähig weiterzufahren, wenn aus der Strasse eine Piste wird. Sie ist unser Fahrzeug, unser Zuhause und inzwischen ein festes Mitglied des Teams.',
    alt: 'Rancherita, der Toyota Hilux mit Wohnkabine, auf einer Strasse zwischen kargen Bergen in Marokko unter blauem Himmel',
    fichaTitle: 'Technische Daten',
    ficha: [
      ['Basisfahrzeug', 'Toyota Hilux, Pick-up 4×4'],
      ['Antrieb', 'Allradantrieb mit Untersetzung'],
      ['Wohnen', 'Über 20 Jahre alte Kabine auf der Ladefläche'],
      ['Energie', 'Solarpanels und Batterie'],
      ['Toilette', 'Trocken und ökologisch'],
      ['Bett', 'Über der Fahrerkabine'],
      ['Küche', 'An Bord, zum Kochen, wo wir gerade stehen'],
      ['Wasser', 'Eigener Tank'],
      ['Name', 'Rancherita, natürlich'],
      ['Gemacht für', 'Pisten, Sand, Berge und lange Reisen'],
    ],
    whyPickup: 'Warum ein Pick-up?',
    whyPickupP: 'Weil wir dorthin wollten, wohin kein Kastenwagen kommt. Allradantrieb, Bodenfreiheit, eine Mechanik, die man auf der ganzen Welt kennt, und eine Grösse, die durch Dorfgassen und über Pisten zwischen Steinmauern passt.',
    whyCabin: 'Warum diese Kabine?',
    whyCabinP: 'Sie ist über 20 Jahre alt und heute für ein autarkes Leben eingerichtet: Solarpanels, Batterie, ökologische Trockentoilette, Wasser und Küche an Bord. Sie ist leicht, zum Wohnen gemacht und abnehmbar. Sie gibt uns die Freiheit, dort zu übernachten, wo es uns gefällt – nicht dort, wo man uns lässt –, ohne auf die Fähigkeiten des 4×4 zu verzichten.',
    gear: 'Was wir dabeihaben',
    gearP: 'Kompressor, Sandbleche, Schaufel, Bergegurt, Werkzeug und die wichtigsten Ersatzteile. Ausführlich erzählen wir davon in',
    gearLink: 'diesem Beitrag',
    story: 'Ihre Geschichte',
    storyP: 'Mit ihr haben wir viereinhalb Monate in Marokko verbracht und sind über den Balkan bis Albanien, durch die Normandie, die Bretagne, die Schweiz und Corsica gereist. Die ganze Geschichte steht in',
    storyLink: 'Wir stellen vor: Rancherita',
  },
}[lang];
---
<Base title={T.title} description={T.desc}>
  <section class="section hero">
    <div class="wrap grid">
      <div>
        <p class="eyebrow">{T.eyebrow}</p>
        <h1>{T.h1} <span class="brand-gradient">Rancherita</span></h1>
        <p class="lead">{T.lead}</p>
      </div>
      <div class="art"><img src={url('fotos/rancherita.jpg')} alt={T.alt} width="2000" height="1500" fetchpriority="high" /></div>
    </div>
  </section>

  <section class="wrap ficha-wrap">
    <h2>{T.fichaTitle}</h2>
    <dl class="ficha">
      {T.ficha.map(([k, v]) => (<div class="reveal"><dt>{k}</dt><dd>{v}</dd></div>))}
    </dl>
  </section>

  <section class="section">
    <div class="wrap two">
      <div class="reveal">
        <h3>{T.whyPickup}</h3>
        <p>{T.whyPickupP}</p>
      </div>
      <div class="reveal">
        <h3>{T.whyCabin}</h3>
        <p>{T.whyCabinP}</p>
      </div>
      <div class="reveal">
        <h3>{T.gear}</h3>
        <p>{T.gearP} <a href={href('blog/preparar-la-4x4-para-pistas', lang)}>{T.gearLink}</a>.</p>
      </div>
      <div class="reveal">
        <h3>{T.story}</h3>
        <p>{T.storyP} <a href={href('blog/presentamos-a-rancherita', lang)}>{T.storyLink}</a>.</p>
      </div>
    </div>
  </section>
</Base>
<style>
  .grid { display: grid; grid-template-columns: 1fr 1.1fr; gap: clamp(32px, 6vw, 80px); align-items: center; }
  .art { border-radius: var(--radio); overflow: hidden; border: 1px solid var(--linea); aspect-ratio: 16 / 10; }
  .art img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: 50% 62%; }
  @media (max-width: 860px) { .grid { grid-template-columns: 1fr; } }
  .ficha { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr)); gap: 1px; background: var(--linea); border: 1px solid var(--linea); border-radius: var(--radio); overflow: hidden; margin: 32px 0 0; }
  .ficha div { background: var(--noche-2); padding: 24px; }
  dt { font-family: var(--font-display); font-size: .62rem; letter-spacing: .2em; text-transform: uppercase; color: var(--salvia); margin-bottom: 8px; }
  dd { margin: 0; font-size: 1.1rem; }
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: 48px 64px; }
  .two p { color: var(--texto-suave); font-family: var(--font-body); }
  @media (max-width: 760px) { .two { grid-template-columns: 1fr; } }
</style>
