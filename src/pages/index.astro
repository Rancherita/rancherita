---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import Illustration from '../components/Illustration.astro';
import PostCard from '../components/PostCard.astro';
import { DESTINOS, SITE, url } from '../config';
import { getPosts } from '../lib/posts';

const posts = await getPosts();
const [featured, ...rest] = posts;
const count = (id: string) => posts.filter((p) => p.data.destino === id).length;
---
<Base>
  <section class="hero">
    <div class="hero-bg"><Illustration scene="horizonte" /></div>
    <div class="wrap hero-inner">
      <Logo size="min(78vw, 400px)" animate class="hero-logo" />
      <div class="hero-copy">
        <p class="eyebrow">Blog de viajes 4×4</p>
        <h1>Lejos del asfalto,<br /><span class="brand-gradient">cerca de la gente.</span></h1>
        <p class="lead">Viajamos con Rancherita, una Toyota Hilux con una cabina Tischer encima. Recorremos pistas, dormimos en la naturaleza y buscamos los lugares donde la gente todavía tiene tiempo para un té.</p>
        <div class="actions">
          <a class="btn btn-primary" href={url('blog')}>Leer el blog</a>
          <a class="btn btn-ghost" href={url('rancherita')}>Conoce a Rancherita</a>
        </div>
      </div>
    </div>
  </section>

  <section class="stats" aria-label="En cifras">
    <div class="wrap stats-grid">
      <div><strong class="brand-gradient">4,5</strong><span>meses en Marruecos</span></div>
      <div><strong class="brand-gradient">Balcanes</strong><span>hasta Albania</span></div>
      <div><strong class="brand-gradient">4×4</strong><span>Toyota Hilux</span></div>
      <div><strong class="brand-gradient">1</strong><span>cabina Tischer, nuestra casa</span></div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div><p class="eyebrow">Diario de ruta</p><h2>Últimas entradas</h2></div>
        <a class="link-arrow" href={url('blog')}>Todas las entradas</a>
      </div>
      {featured && <PostCard post={featured} featured />}
      <div class="grid-3 more">
        {rest.slice(0, 3).map((p) => <PostCard post={p} />)}
      </div>
    </div>
  </section>

  <section class="section pillars-section">
    <div class="wrap">
      <p class="eyebrow">Cómo viajamos</p>
      <h2 class="pillars-title">Tres ideas en cada ruta</h2>
      <div class="pillars">
        <article class="reveal">
          <span class="num">01</span>
          <h3>Naturaleza</h3>
          <p>Valles vacíos, cielos llenos de estrellas y noches lejos de todo. Preferimos el silencio a las multitudes.</p>
        </article>
        <article class="reveal">
          <span class="num">02</span>
          <h3>Pistas y offroad</h3>
          <p>Las pistas conectan lo que la carretera se salta: aldeas, pastos y collados. Sin prisa y sin salirnos del camino.</p>
        </article>
        <article class="reveal">
          <span class="num">03</span>
          <h3>La gente del lugar</h3>
          <p>Evitamos los sitios turísticos y buscamos el contacto con quien vive allí. Lo mejor de cada viaje siempre han sido las personas.</p>
        </article>
      </div>
      <a class="link-arrow" href={url('blog/como-viajamos')}>Nuestra forma de viajar</a>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div><p class="eyebrow">Destinos</p><h2>Dónde hemos estado</h2></div>
        <a class="link-arrow" href={url('destinos')}>Ver destinos</a>
      </div>
      <div class="destinos">
        {Object.entries(DESTINOS).map(([id, d]) => (
          <a class="destino reveal" href={url(`destinos/${id}`)}>
            <Illustration scene={d.cover} />
            <div class="destino-copy">
              <span class="eyebrow">{count(id)} {count(id) === 1 ? 'entrada' : 'entradas'}</span>
              <h3>{d.nombre}</h3>
              <p>{d.resumen}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section truck">
    <div class="wrap truck-grid">
      <div class="truck-art reveal"><Illustration scene="noche" label="Rancherita acampada de noche junto a una hoguera" /></div>
      <div>
        <p class="eyebrow">La autocaravana</p>
        <h2>Una pick-up, una cabina y todo el camino por delante</h2>
        <p class="lead">Rancherita es una Toyota Hilux 4×4 con una cabina Tischer. Pequeña para pasar por cualquier aldea, capaz para seguir cuando se acaba el asfalto y cómoda para vivir en ella durante meses.</p>
        <ul class="specs">
          <li><span>Base</span>Toyota Hilux doble tracción</li>
          <li><span>Vivienda</span>Cabina Tischer desmontable</li>
          <li><span>Terreno</span>Pistas, arena, montaña</li>
        </ul>
        <a class="btn btn-ghost" href={url('rancherita')}>Conoce a Rancherita</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { position: relative; min-height: calc(100svh - 68px); display: grid; align-items: center; overflow: hidden; padding-block: 48px 72px; }
  .hero-bg { position: absolute; inset: auto 0 0 0; height: 34%; opacity: .3; mask-image: linear-gradient(180deg, transparent, #000 60%); -webkit-mask-image: linear-gradient(180deg, transparent, #000 60%); }
  .hero-bg :global(svg) { height: 100%; }
  .hero-bg :global(rect) { fill: transparent; }
  .hero-inner { position: relative; display: grid; grid-template-columns: auto 1fr; gap: clamp(32px, 6vw, 88px); align-items: center; }
  .hero-copy h1 { margin-bottom: .4em; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
  @media (max-width: 900px) {
    .hero-bg { height: 18%; }
    .hero-inner { grid-template-columns: 1fr; justify-items: center; text-align: center; }
    .hero-copy .lead { margin-inline: auto; }
    .actions { justify-content: center; }
    .hero :global(.hero-logo) { width: min(70vw, 300px) !important; }
  }

  .stats { border-block: 1px solid var(--linea); background: var(--noche-2); }
  .stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); }
  .stats-grid div { padding: 32px 24px; display: flex; flex-direction: column; gap: 6px; border-left: 1px solid var(--linea); }
  .stats-grid div:first-child { border-left: 0; padding-left: 0; }
  .stats-grid strong { font-family: var(--font-display); font-weight: 400; font-size: clamp(1.1rem, 2.2vw, 1.7rem); letter-spacing: .06em; width: fit-content; }
  .stats-grid span { color: var(--texto-suave); font-size: .95rem; }
  @media (max-width: 800px) {
    .stats-grid { grid-template-columns: 1fr 1fr; }
    .stats-grid div { padding: 22px 16px; }
    .stats-grid div:nth-child(odd) { border-left: 0; padding-left: 0; }
    .stats-grid div:nth-child(-n + 2) { border-bottom: 1px solid var(--linea); }
  }

  .more { margin-top: 28px; }

  .pillars-section { background: radial-gradient(ellipse at 50% 0%, #152016, transparent 70%); }
  .pillars-title { max-width: 16ch; }
  .pillars { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--linea); border: 1px solid var(--linea); border-radius: var(--radio); overflow: hidden; margin: 40px 0 32px; }
  .pillars article { background: var(--noche); padding: 36px 32px 40px; }
  .pillars article:nth-child(2) { transition-delay: .1s; }
  .pillars article:nth-child(3) { transition-delay: .2s; }
  .num { font-family: var(--font-display); font-size: .8rem; letter-spacing: .2em; color: var(--arena); display: block; margin-bottom: 40px; }
  .pillars p { color: var(--texto-suave); font-family: var(--font-body); margin: 0; }
  @media (max-width: 800px) { .pillars { grid-template-columns: 1fr; } }

  .destinos { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; }
  .destino { position: relative; display: block; border-radius: var(--radio); overflow: hidden; aspect-ratio: 4 / 3; border: 1px solid var(--linea); color: var(--texto); text-decoration: none; }
  .destino :global(svg) { position: absolute; inset: 0; transition: transform .7s ease; }
  .destino:hover :global(svg) { transform: scale(1.05); }
  .destino-copy { position: absolute; inset: auto 0 0; padding: 28px 32px; background: linear-gradient(180deg, transparent, rgba(11, 18, 12, .92) 45%); }
  .destino-copy .eyebrow { margin-bottom: .6rem; }
  .destino-copy h3 { font-size: clamp(1.6rem, 3vw, 2.3rem); margin-bottom: .2em; }
  .destino-copy p { color: var(--texto-suave); margin: 0; font-family: var(--font-body); }
  @media (max-width: 800px) { .destinos { grid-template-columns: 1fr; } .destino { aspect-ratio: 4 / 3.4; } .destino-copy { padding: 22px; } }

  .truck-grid { display: grid; grid-template-columns: 1.1fr 1fr; gap: clamp(32px, 6vw, 80px); align-items: center; }
  .truck-art { border-radius: var(--radio); overflow: hidden; border: 1px solid var(--linea); aspect-ratio: 16 / 11; }
  .specs { list-style: none; padding: 0; margin: 28px 0 32px; border-top: 1px solid var(--linea); }
  .specs li { display: flex; gap: 16px; padding: 14px 0; border-bottom: 1px solid var(--linea); }
  .specs span { font-family: var(--font-display); font-size: .64rem; letter-spacing: .2em; text-transform: uppercase; color: var(--salvia); width: 90px; flex: none; padding-top: .35em; }
  @media (max-width: 860px) { .truck-grid { grid-template-columns: 1fr; } }
</style>
