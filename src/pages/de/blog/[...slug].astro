---
import PostView from '../../../views/Post.astro';
import { getPosts, postSlug } from '../../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts('de');
  return posts.map((post, i) => ({ params: { slug: postSlug(post) }, props: { post, newer: posts[i - 1], older: posts[i + 1] } }));
}
const { post, newer, older } = Astro.props;
---
<PostView post={post} newer={newer} older={older} />
